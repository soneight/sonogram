# print Fahrenheit-Celsius table
celsius_expr-program:
    # NOTE: expr is constant evaluated expression (auto implied by default for -expr keyword)
    LOWER-expr 0
    UPPER-expr 300
    STEP-expr 20

    fahr-int2 LOWER,

    -for { fahr <= UPPER }, fahr{ fahr =+ STEP } :
        -echo `{ fahr } { 5.0 (=/) 9.0 =* fahr (=-) 32.0 }\n`
    ;
;
