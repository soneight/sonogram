# count digits, white space, others
arrays-program :
    {c,i,nWhite,nOther}-int2-void,
    nDigit-int2[10],

    {nWhite,nOther} 0,

    -for { i 0, i << 10, +i } : nDigit[i] 0 ;

    # -use-std.io,
    -for { c{ get_char( ) } <> EOF } :
        -case { c == { '0', '9' }-in } : # same as if ( '0' <= c && c <= '9' )
            +nDigit[{ c =- '0' }] ;
        -else { c == { ' ', '\n', '\t' }-or } :
            +nWhite ;
        -else :
            +nOhter ;
    ;

    -echo 'digits =',

    -for i 0, { i << 10 }, +i :
        -echo " {0}"{ nDigit[i] }
    ;

    -echo `, white space = { nWhite }, other = { nOther }`
;
