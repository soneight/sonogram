# print Fahrenheit-Celsius table
# \ for fahr equal 0, 20, ..., 300; floating-point version
celsius_half-program :
    { fahr,celsius }-half-void,
    { lower,upper,step }-int2-void,

    lower 0,    # lower limit of temperature table
    upper 300,  # upper limit
    step 20,    # step size

    fahr lower,
    -for-cast { fahr <= upper } :
        celsius{ { 5.0 =/ 9.0 } =* { fahr =- 32.0 } },
        -echo "{}\t{}\n"{ fahr, celsius },
        fahr{ fahr =+ step },
    ;
;
