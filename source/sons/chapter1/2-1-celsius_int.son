# print Fahrenheit-Celsius table
# \ for fahr equal 0, 20, ..., 300
celsius_int-program:
    fahr-int2-void,
    celsius-int2-void,
    lower-int2-void,
    upper-int2-void,
    step-int2-void,

    fahr 0,
    upper 300,
    step 20,
    celsius fahr,
    celsius =- 32,
    celsius =* 5,
    celsius =/ 9,
    -echo fahr,
    -echo '\t',
    -echo celsius,
    -echo '\n',
    # NOTE: void in means uninitialized
    # { fahr,celsius }-int2-void,
    # { lower,upper,step }-int2-void,

    # lower 0,    # lower limit of temperature table
    # upper 300,  # upper limit
    # step 20,    # step size

    # fahr lower,
    # -for { fahr <= upper } :
    #    celsius{ 5 =* { fahr =- 32 } =/ 9 },
    #    -echo "{}\t{}\n"{ fahr, celsius },
    #    fahr{ fahr =+ step },
    # ;
;
